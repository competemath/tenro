+  let statements := cliOptions.any (· == "--statements")
+  -- `--drop-proofs`: no theorem is kept with its proof (the first version of `--statements`): a much smaller export of a large tree, in which a definition that only computes through a proof is refused by the kernel at replay
+  let dropProofs := cliOptions.any (· == "--drop-proofs")
+  let kept := if statements && !dropProofs then proofsUsedByDefinitions env else {}
+  if statements then
+    IO.eprintln s!"lean4export --statements: {kept.toList.length} theorems are kept with their proofs, the others are axioms of their type"
   modify fun st => { st with
