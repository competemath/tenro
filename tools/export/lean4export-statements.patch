@@ -7,9 +7,26 @@ def main (args : List String) : IO Unit := do
   let (imports, constants) := args.span (· != "--")
   let imports := imports.toArray.map fun mod => { module := Syntax.decodeNameLit ("`" ++ mod) |>.get! }
   let env ← importModules imports {}
+  -- `--own=Tengoku.Foo` (repeatable): of the whole environment, export only the constants declared in the modules under these names (and what they need): a wave of an export too large for one process.
+  -- The theorems kept with their proofs (`--statements`) are decided over the whole environment either way, so two waves agree on them.
+  let own : List Name := opts.filterMap fun o => if o.startsWith "--own=" then some (o.splitOn "=").getLast!.toName else none
+  let moduleNames : Array Name := env.header.moduleNames
+  let isOwn : Array Bool := moduleNames.map fun m => own.any fun p => p.isPrefixOf m
   let constants := match constants.tail? with
     | some cs => cs.map fun c => Syntax.decodeNameLit ("`" ++ c) |>.get!
-    | none    => env.constants.toList.map Prod.fst |>.filter (!·.isInternal)
+    | none    =>
+      let all : List Name := env.constants.toList.map Prod.fst |>.filter (fun (n : Name) => !n.isInternal)
+      if own.isEmpty then all
+      else all.filter fun n =>
+        match env.getModuleIdxFor? n with
+        | some i => isOwn[i]!
+        | none => false
+  -- `--names-file=FILE`: the constants to export, one name a line (a list of hundreds of thousands does not fit on a command line)
+  let constants ← match opts.findSome? fun o => if o.startsWith "--names-file=" then some (o.splitOn "=").getLast! else none with
+    | some f => do
+      let lines ← IO.FS.lines f
+      pure (lines.toList.filter (!·.isEmpty) |>.map fun c => Syntax.decodeNameLit ("`" ++ c) |>.get!)
+    | none => pure constants
   M.run env do
     let _ ← initState env opts
     dumpMetadata
