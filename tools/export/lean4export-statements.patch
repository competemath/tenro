+  /-- `--statements`: a theorem is exported as an axiom of its type and its proof is not visited, so the constants only proofs use are not exported (a base for search, not for checking) -/
+  statementsOnly : Bool := false
+  /-- `--statements`: the theorems that the VALUE of a definition or an opaque constant mentions are exported with their proofs all the same: the kernel may have to unfold one to check the definition (a `casesOn` on a proof of a conjunction that an auxiliary theorem supplies, `Acc.rec`) -/
+  keepProofs : NameSet := {}
   ignoreMissing : Bool := false
   /-- Maps the name of an inductive type to a list of names of corresponding recursors.
