+/-- the theorems that the value of a definition or of an opaque constant mentions -/
+def proofsUsedByDefinitions (env : Environment) : NameSet := Id.run do
+  let mut s : NameSet := {}
+  for (_, info) in env.constants do
+    let value? : Option Expr := match info with
+      | .defnInfo v => some v.value
+      | .opaqueInfo v => some v.value
+      | _ => none
+    if let some e := value? then
+      for n in e.getUsedConstants do
+        if let some (.thmInfo _) := env.find? n then
+          s := s.insert n
+  return s
+
 /--
